# IntervAI Backend Environment Variables Template
# Copy this file to .env or export these in your runtime environment.

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Security & Authentication (Required: at least 256-bit / 32-character secret)
JWT_SECRET=your_32_byte_base64_or_hex_jwt_secret_key_here_change_in_production
JWT_EXPIRATION_MS=86400000

# Admin Seed Credentials (Optional: used to initialize system administrator in dev)
ADMIN_EMAIL=admin@intervai.com
ADMIN_PASSWORD=admin123

# Artificial Intelligence APIs (Provide either or both for AI feedback generation)
# 1. Google Gemini (Recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Production / PostgreSQL profile)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/intervai
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# CORS Configuration (Comma-separated allowed client origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
